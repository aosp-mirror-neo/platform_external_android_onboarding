package com.android.onboarding.tasks.crossApp;

import android.os.PersistableBundle;
import com.android.onboarding.tasks.OnboardingTaskToken;


/**
 * A Service which manages onboarding tasks.
 */
interface IOnboardingTaskManagerService {

    /**
     * Executes an onboarding task with the provided arguments.
     *
     * @param bundle A [PersistableBundle] is generated by
     * [OnboardingTaskContract][encodeArgs]
     *
     * @return An [OnboardingTaskToken] representing the executed task.
     */
    
    OnboardingTaskToken runTask(in PersistableBundle bundle);
}