package com.android.onboarding.tasks;

import android.os.PersistableBundle;
import com.android.onboarding.tasks.ErasedOnboardingTaskToken;
import com.android.onboarding.tasks.ErasedOnboardingTaskState;
import com.android.onboarding.tasks.IGetTaskStateListener;
import com.android.onboarding.tasks.IOnboardingTaskManagerServiceListener;
import com.android.onboarding.tasks.service.IUnitCallback;
import com.android.onboarding.tasks.service.IResultCallback;
import com.android.onboarding.tasks.service.IObserver;
import com.android.onboarding.tasks.service.IObserverHandle;
import com.android.onboarding.tasks.service.IPersistableBundleStream;


/**
 * A Service which manages onboarding tasks.
 */
interface IOnboardingTaskManagerService {
  /**
   * Starts the executions of an onboarding task with the provided arguments.
   *
   * @param token an {@link ErasedOnboardingTaskToken} assigned to the task
   *   to be executed.
   * @param bundle a {@link PersistableBundle} is generated by
   *   [OnboardingTaskContract][encodeArgs].
   *
   * @return a boolean indicating if the task started succesfully.
   *
   * @deprecated Use {@link startTaskAsync}
   * @since 0
   */


  boolean startTask(in ErasedOnboardingTaskToken token, in PersistableBundle bundle) = 0;

  /**
   * Retrieves an erased task state associated with the {@link token}.
   *
   * @param token an {@link ErasedOnboardingTaskToken} assigned to the task of interest.
   * @return erased state for the token.
   *
   * @deprecated Use {@link getTaskStateAsync} which supports restoring task states from disk.
   * @since 0
   */

  ErasedOnboardingTaskState getTaskState(in ErasedOnboardingTaskToken token) = 1;

  /**
   * Retrieves a task metadata associated with the {@link token}.
   *
   * @param token an {@link ErasedOnboardingTaskToken} assigned to the task of interest.
   * @return a task metadata for the token.
   *
   * @deprecated Use {@link getTaskMetadataAsync}
   * @since 0
   */

  PersistableBundle getTaskMetadata(in ErasedOnboardingTaskToken token) = 2;

  /**
   * Passes an interruption message to an executing task.
   *
   * If the token is not valid then this is no-op.
   *
   * @deprecated Use {@link interruptTaskAsync}
   * @since 0
   */

  void interrupt(in ErasedOnboardingTaskToken token, in PersistableBundle reason) = 3;

  /**
   * Waits for the result of a previously initiated onboarding task.
   *
   * @param token an {@link ErasedOnboardingTaskToken} assigned to the task of interest.
   * @param listener a listener to be invoked when the task completes.
   *
   * @deprecated Use {@link awaitTaskCompletionAsync}
   * @since 0
   */

  void waitForCompleted(in ErasedOnboardingTaskToken token, IOnboardingTaskManagerServiceListener listener) = 4;

  /**
   * Listens for the metadata changes of a previously initiated onboarding task.
   *
   * @param token an {@link ErasedOnboardingTaskToken} assigned to the task of interest.
   * @param listener a listener to be invoked when the task metadata updates and when the task completes.
   *
   * @deprecated Use {@link observeTaskMetadata}
   * @since 0
   */

  void listenForTaskMetadataChanges(in ErasedOnboardingTaskToken token, IOnboardingTaskManagerServiceListener listener) = 5;

  /**
   * Sends a part of a full data as a data chunk.
   *
   * <p>This should be called multiple times, if needed, for the receiver to reassemble the full data.
   *
   * @param token an {@link ErasedOnboardingTaskToken} denoting the receipient.
   * @param dataId a unique identifier for the full data being transferred.
   * @param chunk the payload of the chunk being sent.
   * @param chunkIndex the zero-based index of the chunk being sent.
   * @param totalChunks the number of chunks required to reassemble the full data.
   * @param totalSizeInBytes the size in bytes of the full data.
   *
   * @return a boolean indicating if the all data chunks of the full data are received succesfully.
   * @since 0
   */

  boolean sendDataChunk(in ErasedOnboardingTaskToken token, in int dataId, in byte[] chunk, in int chunkIndex, in int totalChunks, in int totalSizeInBytes) = 6;

  /**
   * Fetches a part of a full data as a data chunk.
   *
   * <p>This should be called multiple times, if needed, for the caller to reassemble the full data.
   *
   * @param token an {@link ErasedOnboardingTaskToken} denoting the receipient.
   * @param dataId a unique identifier for the full data being fetched.
   * @param chunkIndex the zero-based index of the chunk being fetched.
   * @param totalChunks the number of chunks required to reassemble the full data.
   * @param totalSizeInBytes the size in bytes of the full data.
   *
   * @return the payload of the data chunk fetched.
   * @since 0
   */
  byte[] fetchDataChunk(in ErasedOnboardingTaskToken token, in int dataId, in int chunkIndex, in int totalChunks, in int totalSizeInBytes) = 7;

  /**
   * Retrieves an erased task state associated with the {@link token}.
   *
   * @param token an {@link ErasedOnboardingTaskToken} assigned to the task of interest.
   * @return listener a listener to be invoked when the retrieval completes.
   *
   * @deprecated Use {@link getTaskStateAsync}
   * @since 0
   */

  void getTaskStateWithCallback(in ErasedOnboardingTaskToken token, IGetTaskStateListener listener) = 8;

  //================================ Version 1 ================================
  // DESIGN=___

  /**
   * Version of this implementation to know which methods are available.
   *
   * Versions are 0 indexed to allow us use default int value as an implied
   * version for legacy APIs before this method was added.
   *
   * @since 1
   */
  int version() = 9;

  /**
  * Starts the executions of an onboarding task with the provided arguments.
  *
  *
  * @param token an {@link ErasedOnboardingTaskToken} assigned to the task
  *   to be executed.
  * @param input a {@link IPersistableBundleStream} is generated by
  *   [OnboardingTaskContract][encodeArgs].
  * @param callback a callback to be invoked when the task is ready to be started.
  *   The callback is always invoked just before the task execution begins.
  * @since 1
  */
  oneway void startTaskAsync(in IPersistableBundleStream token, in IPersistableBundleStream input, IUnitCallback callback) = 10;

  /**
   * Retrieves an erased task state associated with the {@link token}.
   *
   * @param token an {@link ErasedOnboardingTaskToken} assigned to the task of interest.
   * @param callback a callback to be invoked when the retrieval completes.
   * @since 1
   */
  oneway void getTaskStateAsync(in IPersistableBundleStream token, IResultCallback callback) = 11;

  /**
  * Observe task state changes of a previously initiated onboarding task.
  *
  * @param token an {@link ErasedOnboardingTaskToken} assigned to the task of interest.
  * @param observer a listener to be invoked when the task state updates and when the task completes.
  * @return a handle of the observer which can be used to remove the observer.
  * @since 1
  */
  IObserverHandle observeTaskState(in IPersistableBundleStream token, IObserver observer) = 12;

  /**
  * Retrieves a task metadata associated with the {@link token}.
  *
  * @param token an {@link ErasedOnboardingTaskToken} assigned to the task of interest.
  * @param callback a callback to be invoked when the retrieval completes.
  * @since 1
  */
  oneway void getTaskMetadataAsync(in IPersistableBundleStream token, IResultCallback callback) = 13;

  /**
  * Listens for the metadata changes of a previously initiated onboarding task.
  *
  * @param token an {@link ErasedOnboardingTaskToken} assigned to the task of interest.
  * @param observer a listener to be invoked when the task metadata updates and when the task completes.
  * @return a handle of the observer which can be used to remove the observer.
  * @since 1
  */
  IObserverHandle observeTaskMetadata(in IPersistableBundleStream token, IObserver observer) = 14;

  /**
  * Passes an interruption message to an executing task.
  *
  * If the token is not valid then this is no-op.
  * @param token an {@link ErasedOnboardingTaskToken} assigned to the task of interest.
  * @param callback a callback to be invoked when the interruption completes.
  * @since 1
  */
  oneway void interruptTaskAsync(in IPersistableBundleStream token, in IPersistableBundleStream reason, IUnitCallback callback) = 15;

  /**
  * Waits for the result of a previously initiated onboarding task.
  *
  * @param token an {@link ErasedOnboardingTaskToken} assigned to the task of interest.
  * @param callback a callback to be invoked when the task completes.
  * @since 1
  */
  oneway void awaitTaskCompletionAsync(in IPersistableBundleStream token, IResultCallback callback) = 16;
}
