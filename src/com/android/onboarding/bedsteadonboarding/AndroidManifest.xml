<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.android.onboarding.bedsteadonboarding">

  <uses-sdk
      android:minSdkVersion="29"
      android:targetSdkVersion="34" />
  <application>

    <!-- LINT.IfChange(activity_action_name) -->
    <activity
        android:name=".activities.TrampolineActivity"
        android:exported="true">
      <intent-filter>
        <action android:name="${applicationId}.bedstead.onboarding.trampolineactivity" />
        <category android:name="android.intent.category.DEFAULT" />
      </intent-filter>
    </activity>
    <!-- LINT.ThenChange(src/com/android/onboarding/bedsteadonboarding/OnboardingTestsRule.kt:activity_action_name) -->

    <!-- LINT.IfChange(authority) -->
    <provider
        android:name="com.android.onboarding.bedsteadonboarding.providers.TestContentProvider"
        android:authorities="${applicationId}.testprovider"
        android:exported="true" />
    <!-- LINT.ThenChange(src/com/android/onboarding/bedsteadonboarding/providers/ConfigProviderUtil.kt:authority) -->
  </application>
</manifest>
