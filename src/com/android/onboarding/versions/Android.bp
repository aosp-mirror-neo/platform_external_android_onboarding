package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

// For now we exclude dagger + hilt as those dependencies aren't available
android_library {
    name: "android_onboarding.versions",
    manifest: ":android_onboarding.AndroidManifest",
    srcs: [
        "ComplianceDate.kt",
        "DefaultOnboardingChanges.kt",
        "OnboardingChanges.kt",
        "Versions.kt",
    ],
    dont_merge_manifests: true,
    static_libs: [
        "android_onboarding.versions.annotations",
        "android_onboarding.versions.changes",
    ],
}
